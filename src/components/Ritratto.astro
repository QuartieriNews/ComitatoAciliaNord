---
// Foto di una persona del direttivo, in un quadrato con gli angoli arrotondati. Finché la foto non c'è,
// si vede la figura del logo (testa e braccia aperte, come nelle icone di «Cosa facciamo» e nella scena
// della home) in bianco su uno dei colori del logo. La grandezza la decide chi lo usa con --misura-ritratto.
interface Props {
  nome: string;
  foto?: string;
  colore: string;
}

const { foto, colore } = Astro.props;
---

{
  foto ? (
    <img class="ritratto" src={foto} alt="" width="320" height="320" loading="lazy" style={`--colore:${colore}`} />
  ) : (
    <span class="ritratto ritratto-vuoto" style={`--colore:${colore}`} aria-hidden="true">
      <svg viewBox="0 0 100 100" focusable="false">
        <g transform="translate(50 40.7) scale(0.9)">
          <circle r="17.2" />
          <path d="M-33.47 5.86A33.5 33.5 0 1 0 33.47 5.86A36.6 36.6 0 0 1-33.47 5.86Z" />
        </g>
      </svg>
    </span>
  )
}

<style>
  .ritratto {
    display: grid;
    place-items: center;
    width: var(--misura-ritratto, 8rem);
    height: var(--misura-ritratto, 8rem);
    border-radius: 22%;
    object-fit: cover;
    background: var(--colore);
    /* doppia cornice: bianca e poi del colore, segue gli angoli arrotondati */
    box-shadow:
      0 0 0 4px var(--carta),
      0 0 0 7px var(--colore);
  }

  .ritratto-vuoto svg {
    width: 100%;
    height: 100%;
    fill: #fff;
  }
</style>
