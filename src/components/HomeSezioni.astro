---
// Le sezioni della home sotto l'intestazione animata.
import ElencoNotizie from './ElencoNotizie.astro';
import { comitato, direttivo, sostenitori } from '../data/comitato';
import { giornalino, nomeGiornalino, pesoPdf } from '../data/giornalino';
import { tutteLeNotizie } from '../data/notizie';

const ultime = tutteLeNotizie().slice(0, 5);
const ultimoNumero = giornalino.find((n) => n.pdf) ?? giornalino[0];

// Per la scheda «Chi siamo»: i volti del direttivo, dodici riquadri. Se le foto sono meno di dodici,
// i riquadri che restano hanno la figura del logo, come nella pagina Chi siamo.
const VOLTI = 12;
const fotoDirettivo = [...direttivo.cariche, ...direttivo.consiglieri].flatMap((p) => (p.foto ? [p.foto] : []));
const volti: (string | null)[] = [...fotoDirettivo, ...Array(VOLTI).fill(null)].slice(0, VOLTI);
---

<section class="sezione">
  <div class="contenitore doppia">
    <div>
      <div class="sezione-testa">
        <h2>Ultime notizie</h2>
        <a href="/news/">Tutte le notizie</a>
      </div>
      <ElencoNotizie notizie={ultime} />
    </div>

    <div>
      <div class="sezione-testa">
        <h2>{nomeGiornalino}</h2>
        <a href="/giornalino/">Tutti i numeri</a>
      </div>
      <article class="ultimo-numero">
        {ultimoNumero.copertina && ultimoNumero.pdf && (
          <a class="ultimo-copertina" href={ultimoNumero.pdf} tabindex="-1" aria-hidden="true">
            <img src={ultimoNumero.copertina} alt="" width="640" height="842" loading="lazy" />
          </a>
        )}
        <div>
          <p class="numero-testa">Numero {ultimoNumero.numero}, {ultimoNumero.uscita}</p>
          <h3>{ultimoNumero.titolo}</h3>
          <p>{ultimoNumero.sommario}</p>
          {ultimoNumero.pdf && (
            <p>
              <a href={ultimoNumero.pdf}>Sfoglia il numero {ultimoNumero.numero}</a>
              <span class="tenue"> (PDF, {pesoPdf(ultimoNumero.pdf)})</span>
            </p>
          )}
        </div>
      </article>
    </div>
  </div>
</section>

<!-- Le pagine che non hanno un'anteprima nella home: senza questo blocco si trovano solo dal menu -->
<section class="sezione">
  <div class="contenitore">
    <h2>Conosci il comitato e il quartiere</h2>
    <ul class="schede">
      <li class="scheda">
        <div class="scheda-media volti" aria-hidden="true">
          {
            volti.map((foto) =>
              foto ? (
                <img src={foto} alt="" width="400" height="400" loading="lazy" />
              ) : (
                <span class="volto-vuoto">
                  <svg viewBox="0 0 100 100" focusable="false">
                    <g transform="translate(50 40.7) scale(0.9)">
                      <circle r="17.2" />
                      <path d="M-33.47 5.86A33.5 33.5 0 1 0 33.47 5.86A36.6 36.6 0 0 1-33.47 5.86Z" />
                    </g>
                  </svg>
                </span>
              ),
            )
          }
        </div>
        <h3><a href="/chi-siamo/">Chi siamo</a></h3>
        <p>Cosa facciamo, chi fa parte del direttivo e il premio «Energie per Roma» 2026.</p>
      </li>
      <li class="scheda">
        <img
          class="scheda-media"
          src="/storia/borgata-dall-alto-anni-40-800.webp"
          alt=""
          width="800"
          height="536"
          loading="lazy"
        />
        <h3><a href="/storia/">La nostra storia</a></h3>
        <p>Dall'antica Ficana al Sentiero Pasolini: la storia del quartiere in otto capitoli, con le foto della mostra del comitato.</p>
      </li>
      <li class="scheda">
        <img
          class="scheda-media"
          src="/storia/panchina-san-nicola-2018-800.webp"
          alt=""
          width="800"
          height="552"
          loading="lazy"
        />
        <h3><a href="/il-quartiere/">Il quartiere</a></h3>
        <p>I Monti di San Paolo e il Poggio di Acilia, tra il Tevere e la Riserva del Litorale Romano: i luoghi da conoscere.</p>
      </li>
    </ul>
  </div>
</section>

<section class="sezione">
  <div class="contenitore">
    <div class="sezione-testa">
      <h2>Come partecipare</h2>
      <a href="/partecipa/">Tutti i modi</a>
    </div>
    <div class="tre">
      <div class="passo">
        <h3>Fai una donazione</h3>
        <p>Una donazione ci aiuta a portare avanti le iniziative per il quartiere. Puoi farla a uno dei nostri eventi, oppure con un bonifico.</p>
        <a href="/partecipa/#donazioni">Scopri come donare</a>
      </div>
      <div class="passo">
        <h3>Vieni e partecipa ai nostri eventi</h3>
        <p>Puliamo giardini e aree verdi, organizziamo passeggiate, feste e incontri. Una mano in più è sempre utile, anche solo per una mattina.</p>
        <a href={`mailto:${comitato.email}?subject=Voglio%20dare%20una%20mano`}>Scrivici per dare una mano</a>
      </div>
      <div class="passo">
        <h3>Diventa socio</h3>
        <p>Con la quota associativa sostieni le attività del comitato e partecipi alle sue iniziative.</p>
        <a href={`mailto:${comitato.email}?subject=Diventare%20socio`}>Chiedi come iscriverti</a>
      </div>
    </div>
  </div>
</section>

<section class="sezione">
  <div class="contenitore">
    <h2>Grazie a chi ci sostiene</h2>
    <ul class="loghi">
      {sostenitori.map((s) => (
        <li>
          {s.link ? (
            <a href={s.link}>
              <img src={s.logo} alt={s.nome} width="420" height="420" loading="lazy" />
            </a>
          ) : (
            <img src={s.logo} alt={s.nome} width="420" height="420" loading="lazy" />
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ultimo-numero {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .ultimo-copertina {
    display: block;
    border-radius: 4px;
    overflow: hidden;
    box-shadow:
      0 1px 2px rgb(29 37 48 / 0.12),
      0 8px 22px rgb(29 37 48 / 0.12);
  }

  .ultimo-numero h3 {
    margin: 0.2rem 0 0.4rem;
  }

  .ultimo-numero p {
    margin-bottom: 0.6em;
  }

  /* «Conosci il comitato e il quartiere»: tre schede con immagine, tutta la scheda porta alla pagina */
  .schede {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .scheda {
    position: relative;
  }

  .scheda-media {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 0.9rem;
  }

  .scheda h3 {
    margin: 0 0 0.35rem;
    font-size: 1.3rem;
  }

  .scheda h3 a {
    color: inherit;
    text-decoration: none;
  }

  /* il link del titolo copre tutta la scheda */
  .scheda h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .scheda:hover h3 a,
  .scheda h3 a:focus-visible {
    text-decoration: underline;
  }

  .scheda p {
    margin: 0;
  }

  /* i volti del direttivo: dodici riquadri arrotondati come nella pagina Chi siamo */
  .volti {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 5px;
    border-radius: 0;
  }

  .volti img,
  .volto-vuoto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 18%;
  }

  .volto-vuoto {
    display: block;
    background: var(--pino);
  }

  .volto-vuoto svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: #fff;
  }

  /* tablet: una scheda per riga, immagine a sinistra */
  @media (max-width: 52rem) {
    .schede {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .scheda {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      grid-template-rows: auto 1fr;
      column-gap: 1.25rem;
      align-content: start;
    }

    .scheda-media {
      grid-column: 1;
      grid-row: 1 / span 2;
      margin-bottom: 0;
    }

    .scheda h3,
    .scheda p {
      grid-column: 2;
    }
  }

  /* telefono: immagine sopra */
  @media (max-width: 30rem) {
    .scheda {
      display: block;
    }

    .scheda-media {
      margin-bottom: 0.9rem;
    }
  }

  .loghi {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .loghi img {
    display: block;
    width: 8.5rem;
    height: 8.5rem;
    border-radius: 14px;
    box-shadow: 0 0 0 1px var(--linea);
  }

  .loghi a:hover img {
    box-shadow:
      0 0 0 1px var(--linea),
      0 8px 20px rgb(29 37 48 / 0.15);
  }

  @media (max-width: 26rem) {
    .ultimo-numero {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
