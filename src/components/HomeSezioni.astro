---
// Le sezioni della home sotto l'intestazione animata.
import ElencoNotizie from './ElencoNotizie.astro';
import { comitato, sostenitori } from '../data/comitato';
import { giornalino, nomeGiornalino, pesoPdf } from '../data/giornalino';
import { tutteLeNotizie } from '../data/notizie';

const ultime = tutteLeNotizie().slice(0, 5);
const ultimoNumero = giornalino.find((n) => n.pdf) ?? giornalino[0];
---

<section class="sezione">
  <div class="contenitore doppia">
    <div>
      <div class="sezione-testa">
        <h2>Ultime notizie</h2>
        <a href="/news/">Tutte le notizie</a>
      </div>
      <ElencoNotizie notizie={ultime} />
    </div>

    <div>
      <div class="sezione-testa">
        <h2>{nomeGiornalino}</h2>
        <a href="/giornalino/">Tutti i numeri</a>
      </div>
      <article class="ultimo-numero">
        {ultimoNumero.copertina && ultimoNumero.pdf && (
          <a class="ultimo-copertina" href={ultimoNumero.pdf} tabindex="-1" aria-hidden="true">
            <img src={ultimoNumero.copertina} alt="" width="640" height="842" loading="lazy" />
          </a>
        )}
        <div>
          <p class="numero-testa">Numero {ultimoNumero.numero}, {ultimoNumero.uscita}</p>
          <h3>{ultimoNumero.titolo}</h3>
          <p>{ultimoNumero.sommario}</p>
          {ultimoNumero.pdf && (
            <p>
              <a href={ultimoNumero.pdf}>Sfoglia il numero {ultimoNumero.numero}</a>
              <span class="tenue"> (PDF, {pesoPdf(ultimoNumero.pdf)})</span>
            </p>
          )}
        </div>
      </article>
    </div>
  </div>
</section>

<section class="sezione">
  <div class="contenitore">
    <div class="sezione-testa">
      <h2>Come partecipare</h2>
      <a href="/partecipa/">Tutti i modi</a>
    </div>
    <div class="tre">
      <div class="passo">
        <h3>Segnala un problema</h3>
        <p>Mandaci una foto, l'indirizzo preciso e una descrizione chiara. Portiamo noi la segnalazione agli uffici competenti e la seguiamo.</p>
        <a href={`mailto:${comitato.email}?subject=Segnalazione`}>Scrivi una segnalazione</a>
      </div>
      <div class="passo">
        <h3>Entra in {comitato.whatsapp.nome}</h3>
        <p>Il gruppo WhatsApp del comitato, per sapere cosa succede nel quartiere.</p>
        <a href={comitato.whatsapp.link}>Entra nel gruppo</a>
      </div>
      <div class="passo">
        <h3>Diventa socio</h3>
        <p>Con la quota associativa sostieni le attività del comitato e partecipi alle sue iniziative.</p>
        <a href={`mailto:${comitato.email}?subject=Diventare%20socio`}>Chiedi come iscriverti</a>
      </div>
    </div>
  </div>
</section>

<section class="sezione">
  <div class="contenitore">
    <h2>Grazie a chi ci sostiene</h2>
    <ul class="loghi">
      {sostenitori.map((s) => (
        <li>
          {s.link ? (
            <a href={s.link}>
              <img src={s.logo} alt={s.nome} width="420" height="420" loading="lazy" />
            </a>
          ) : (
            <img src={s.logo} alt={s.nome} width="420" height="420" loading="lazy" />
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ultimo-numero {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .ultimo-copertina {
    display: block;
    border-radius: 4px;
    overflow: hidden;
    box-shadow:
      0 1px 2px rgb(29 37 48 / 0.12),
      0 8px 22px rgb(29 37 48 / 0.12);
  }

  .ultimo-numero h3 {
    margin: 0.2rem 0 0.4rem;
  }

  .ultimo-numero p {
    margin-bottom: 0.6em;
  }

  .loghi {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .loghi img {
    display: block;
    width: 8.5rem;
    height: 8.5rem;
    border-radius: 14px;
    box-shadow: 0 0 0 1px var(--linea);
  }

  .loghi a:hover img {
    box-shadow:
      0 0 0 1px var(--linea),
      0 8px 20px rgb(29 37 48 / 0.15);
  }

  @media (max-width: 26rem) {
    .ultimo-numero {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
