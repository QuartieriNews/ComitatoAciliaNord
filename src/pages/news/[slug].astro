---
import Base from '../../layouts/Base.astro';
import FotoNotizia from '../../components/FotoNotizia.astro';
import { categoria, idCategoria } from '../../data/categorie';
import { dataLeggibile, tutteLeNotizie, type Notizia } from '../../data/notizie';

export function getStaticPaths() {
  return tutteLeNotizie().map((notizia) => ({
    params: { slug: notizia.slug },
    props: { notizia },
  }));
}

const { notizia } = Astro.props as { notizia: Notizia };
const cat = categoria(notizia.category);
const { Content } = notizia;
// Le notizie scritte prima della galleria hanno solo la copertina («image»): vale come unica foto.
const foto = notizia.foto ?? (notizia.image ? [{ src: notizia.image }] : []);
---

<Base title={notizia.title} description={notizia.summary}>
  {/* data-pagefind-*: cosa entra nell'indice della ricerca (vedi components/CercaNotizie.astro) */}
  <article data-pagefind-body>
    <header class="pagina-testa">
      <div class="contenitore">
        <div class="meta" style={`--cat:${cat.colore}`} data-pagefind-ignore>
          <time datetime={notizia.date} data-pagefind-meta="quando">{dataLeggibile(notizia.date)}</time>
          <span class="categoria" data-pagefind-filter={`categoria:${idCategoria(notizia.category)}`}>{cat.nome}</span>
        </div>
        <h1>{notizia.title}</h1>
        {notizia.summary && <p class="introduzione" data-pagefind-ignore>{notizia.summary}</p>}
      </div>
    </header>

    <div class="sezione">
      <div class="contenitore testo">
        <FotoNotizia foto={foto} titolo={notizia.title} parte="sopra" />
        <Content />
        <FotoNotizia foto={foto} titolo={notizia.title} parte="sotto" />
        {notizia.facebook && (
          <p class="fonte" data-pagefind-ignore>
            <a href={notizia.facebook}>Commenta su Facebook</a>
          </p>
        )}
        <p data-pagefind-ignore><a href="/news/">Tutte le notizie</a></p>
      </div>
    </div>
  </article>
</Base>
