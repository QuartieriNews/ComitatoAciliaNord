---
import Base from '../layouts/Base.astro';
import { comitato } from '../data/comitato';
import { capitoli } from '../data/storia';

const colori = (c: { vivo: string; scuro: string }) => `--vivo:${c.vivo};--scuro:${c.scuro}`;
---

<Base
  title="Il quartiere"
  description="Monti di San Paolo e Poggio di Acilia: la storia del quartiere, dalle Casette Pater a oggi, e i luoghi che lo raccontano."
>
  <section class="pagina-testa">
    <div class="contenitore">
      <h1>Il quartiere</h1>
      <p class="introduzione">
        Acilia Nord sono i Monti di San Paolo e il Poggio di Acilia, nel Municipio Roma X. Una borgata nata intorno alle
        Casette Pater, tra il Tevere, la Riserva del Litorale Romano e le tracce dell'antica Ficana.
      </p>
    </div>
  </section>

  <section class="sezione">
    <div class="contenitore">
      <div class="sezione-testa">
        <h2>La nostra storia</h2>
        <a href="/storia/">Leggi tutta la storia</a>
      </div>
      <p class="misura-breve">
        Dall'antica Ficana al Sentiero Pasolini: la storia del quartiere in otto capitoli, con le foto della mostra del
        comitato.
      </p>
      <ol class="anteprima">
        {
          capitoli.map((c) => (
            <li style={colori(c)}>
              <a href={`/storia/#${c.id}`}>
                <span class="anteprima-anno">{c.anno}</span>
                <span class="anteprima-titolo">{c.titolo}</span>
                <span class="anteprima-testo">{c.inBreve}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <div class="invito-storia">
        <p>
          Questo è solo un assaggio. Nella storia completa ogni capitolo ha il suo racconto, con le foto della mostra e i
          ricordi delle famiglie che hanno fatto il quartiere.
        </p>
        <a class="bottone bottone-pieno" href="/storia/">Leggi la nostra storia</a>
      </div>
    </div>
  </section>

  <section class="sezione">
    <div class="contenitore">
      <h2>I luoghi</h2>
      <div class="tre">
        <div class="passo">
          <h3>Piazza Capelvenere</h3>
          <p>
            Il cuore del quartiere dal 1940. Oggi ci sono gli uffici del Municipio, la Torretta e la fontana con la lapide
            dedicata a Lido Duranti.
          </p>
        </div>
        <div class="passo">
          <h3>Casale Raggio di Sole</h3>
          <p>In via di Monte Cugno 10. Qui si tengono le assemblee pubbliche e gli eventi del comitato.</p>
        </div>
        <div class="passo">
          <h3>La pinetina</h3>
          <p>La pinetina dei Monti di San Paolo è andata persa per la cocciniglia. Nel 2025 il Municipio ha piantato peri fioriti al capolinea dell'08.</p>
        </div>
        <div class="passo">
          <h3>Sentiero Pasolini</h3>
          <p>
            Il sentiero sull'argine del Tevere che i volontari curano dal 2018: oggi si percorre da Centro Giano a Ostia
            Antica.
          </p>
        </div>
        <div class="passo">
          <h3>Le parrocchie</h3>
          <p>San Maurizio Martire e San Leonardo da Porto Maurizio, con cui il comitato collabora.</p>
        </div>
        <div class="passo">
          <h3>{comitato.sede.nome}</h3>
          <p>{comitato.sede.indirizzo}, {comitato.sede.riferimento}. Aperta il {comitato.apertura.giorno} {comitato.apertura.orario}.</p>
        </div>
      </div>
      <div class="azioni">
        <a class="bottone bottone-vuoto" href={comitato.mappaQuartiere}>Guarda il quartiere sulla mappa</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .misura-breve {
    max-width: var(--misura);
    font-size: 1.08rem;
  }

  /* Gli otto capitoli della storia, ognuno con il suo colore */
  .anteprima {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
    gap: 1.1rem;
  }

  .anteprima a {
    display: block;
    height: 100%;
    padding: 0.85rem 1rem 1rem;
    border: 1px solid var(--linea);
    border-top: 6px solid var(--vivo);
    border-radius: 6px 6px 10px 10px;
    color: var(--testo);
    text-decoration: none;
  }

  .anteprima a:hover {
    background: #f6f8f7;
  }

  .anteprima-anno {
    display: block;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--scuro);
  }

  .anteprima-titolo {
    display: block;
    margin: 0.1rem 0 0.35rem;
    font-size: 1.12rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--scuro);
  }

  .anteprima a:hover .anteprima-titolo {
    text-decoration: underline;
  }

  .anteprima-testo {
    display: block;
    font-size: 0.95rem;
    color: var(--tenue);
    line-height: 1.45;
  }

  /* Dopo l'assaggio dei capitoli, l'invito a leggere la storia intera: una frase che dice cosa si trova e il bottone */
  .invito-storia {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 1.75rem;
    padding: 1.4rem 1.6rem;
    background: var(--carta-b);
    border-radius: 12px;
  }

  .invito-storia p {
    margin: 0;
    max-width: 46rem;
    text-wrap: pretty;
    font-size: 1.15rem;
    line-height: 1.45;
    color: var(--inchiostro);
  }

  .invito-storia .bottone {
    flex-shrink: 0;
  }

  @media (max-width: 44rem) {
    .invito-storia {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.2rem 1.25rem;
    }
  }
</style>
