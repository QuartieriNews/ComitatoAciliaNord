---
// Home, versione A: intestazione con l'orario della sede del comitato.
import Base from '../layouts/Base.astro';
import HomeSezioni from '../components/HomeSezioni.astro';
import { comitato, doveSiamo } from '../data/comitato';
---

<Base>
  <section class="apertura">
    <div class="apertura-griglia">
      <div>
        <h1>Ogni {comitato.apertura.giorno}, {comitato.apertura.orario}, la sede del comitato è aperta</h1>
        <p>Vieni a portare una segnalazione, un'idea o una mano. Ci trovi in {doveSiamo}.</p>
        <div class="azioni">
          <a class="bottone bottone-pieno" href={comitato.sede.mappa}>Apri la mappa</a>
          <a class="bottone bottone-vuoto" href={comitato.whatsapp.link}>Entra in {comitato.whatsapp.nome}</a>
        </div>
      </div>
      <div class="apertura-logo">
        <img src="/logo-comitato.webp" alt="Logo del Comitato Acilia Nord 2018" width="480" height="505" />
      </div>
    </div>
  </section>

  <HomeSezioni />
</Base>
