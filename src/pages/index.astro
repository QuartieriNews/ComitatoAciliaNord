---
// Home: intestazione animata con il cerchio di persone del logo.
import Base from '../layouts/Base.astro';
import HomeSezioni from '../components/HomeSezioni.astro';
import ScenaHome from '../components/ScenaHome.astro';
import { comitato, doveSiamo } from '../data/comitato';
---

<Base home>
  <ScenaHome />

  <!-- Solo l'orario della sede: «Seguici su» con Facebook e WhatsApp sta nell'intestazione, sopra
       (richiesta di Riccardo del 5 novembre 2026, perché non si ripeta) -->
  <section class="fascia-sede">
    <div class="contenitore">
      <p>
        <strong>La sede del comitato è aperta ogni {comitato.apertura.giorno} {comitato.apertura.orario}</strong>, in {doveSiamo}.
      </p>
    </div>
  </section>

  <HomeSezioni />
</Base>

<style>
  /* La strada su cui poggiano le case */
  .fascia-sede {
    background: var(--pino);
    color: #fff;
    padding: 1.35rem 0;
  }

  /* La frase va su una riga sola quando c'è spazio; sul telefono va a capo da sola */
  .fascia-sede p {
    margin: 0;
    font-size: 1.05rem;
    text-wrap: pretty;
  }
</style>
