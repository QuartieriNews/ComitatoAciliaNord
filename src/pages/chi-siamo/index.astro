---
import Base from '../../layouts/Base.astro';
import { comitato, direttivo } from '../../data/comitato';

// Cosa facciamo: ogni attività ha un'icona bianca in un tondo colorato, come i badge della home.
// I colori vengono dal cerchio di persone del logo.
const persona = (x: number, y: number, s: number) =>
  `<g transform="translate(${x} ${y}) scale(${s})"><circle r="17.2"/><path d="M-33.47 5.86A33.5 33.5 0 1 0 33.47 5.86A36.6 36.6 0 0 1-33.47 5.86Z"/></g>`;

const attivita = [
  {
    titolo: 'Partecipazione',
    testo: 'Favoriamo la partecipazione dei cittadini e la collaborazione con enti pubblici, privati e altre associazioni del territorio.',
    colore: '#d60a8b',
    icona: `<g fill="#fff">${persona(13, 24, 0.2)}${persona(35, 24, 0.2)}${persona(24, 19, 0.25)}</g>`,
  },
  {
    titolo: 'Richieste dei residenti',
    testo: 'Portiamo le richieste dei residenti alla pubblica amministrazione e ai gestori dei servizi, e le seguiamo fino alla risposta.',
    colore: '#e84435',
    icona: `<path fill="#fff" d="M14 12h20a4 4 0 0 1 4 4v13a4 4 0 0 1-4 4H22l-7 6v-6h-1a4 4 0 0 1-4-4V16a4 4 0 0 1 4-4z"/><path d="M17.5 22.5 21.5 26.5 30.5 17.5" fill="none" stroke="#e84435" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    titolo: 'Un quartiere vivibile',
    testo: 'Ci occupiamo di sicurezza, urbanistica, ambiente, decoro urbano e viabilità.',
    colore: '#1e8f34',
    icona: `<g fill="#fff"><path d="M9 25 19.5 15.5 30 25v12H9z"/><circle cx="35" cy="22" r="6"/><rect x="33.8" y="26" width="2.4" height="11" rx="1"/></g><rect x="17" y="29" width="5" height="8" rx="1" fill="#1e8f34"/>`,
  },
  {
    titolo: 'Eccellenze del territorio',
    testo: 'Valorizziamo le eccellenze del territorio: Ficana, la Riserva Statale del Litorale Romano, le Casette Pater.',
    colore: '#6c2e83',
    icona: `<g fill="#fff"><path d="M9 18 24 10l15 8z"/><rect x="10" y="19.5" width="28" height="3" rx="1"/><rect x="12.5" y="24" width="3.4" height="10"/><rect x="19.2" y="24" width="3.4" height="10"/><rect x="25.4" y="24" width="3.4" height="10"/><rect x="32.1" y="24" width="3.4" height="10"/><rect x="9" y="35" width="30" height="3.2" rx="1"/></g>`,
  },
  {
    titolo: 'Piano di Recupero Urbano',
    testo: 'Seguiamo il completamento del Piano di Recupero Urbano Acilia-Dragona.',
    colore: '#1182ae',
    icona: `<g fill="#fff"><rect x="17" y="11" width="4" height="26" rx="1"/><rect x="9" y="13" width="31" height="3.2" rx="1"/><rect x="31.5" y="24" width="5" height="4" rx="1"/><rect x="12" y="36" width="14" height="3" rx="1"/></g><path d="M19 8 10 13M19 8 39 13M34 16v8" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/>`,
  },
  {
    titolo: 'Informazione',
    testo: 'Informiamo i cittadini con volantini, social, il giornalino e le assemblee pubbliche.',
    colore: '#c75f00',
    icona: `<rect x="11" y="12" width="26" height="25" rx="2.5" fill="#fff"/><g fill="#c75f00"><rect x="14.5" y="16" width="19" height="4" rx="1"/><rect x="14.5" y="23.5" width="8.5" height="2" rx="1"/><rect x="14.5" y="27.5" width="8.5" height="2" rx="1"/><rect x="14.5" y="31.5" width="8.5" height="2" rx="1"/><rect x="25" y="23.5" width="8.5" height="10" rx="1"/></g>`,
  },
];
---

<Base title="Chi siamo" description="Il Comitato di Quartiere Acilia Nord 2018: chi siamo, cosa facciamo e chi fa parte del direttivo.">
  <section class="pagina-testa">
    <div class="contenitore">
      <h1>Chi siamo</h1>
      <p class="introduzione">
        Il {comitato.nome} è nato il {comitato.fondazione} dall'incontro di volontari nati e cresciuti nel quartiere.
        Ci occupiamo di {comitato.zone}: dei problemi da risolvere, ma anche dei punti di forza e delle eccellenze che ci circondano.
      </p>
    </div>
  </section>

  <section class="sezione">
    <div class="contenitore">
      <h2>Volontari, apolitici, uno di noi</h2>
      <div class="tre">
        <div class="passo">
          <h3>Volontari</h3>
          <p>Molti interventi a cui ci dedichiamo dovrebbero arrivare dalle amministrazioni. Ma l'esempio può spingerle a intervenire dove serve.</p>
        </div>
        <div class="passo">
          <h3>Apolitici</h3>
          <p>Il comitato è autonomo e apartitico. Chi ricopre cariche politiche o di partito non può far parte del direttivo.</p>
        </div>
        <div class="passo">
          <h3>Uno di noi</h3>
          <p>Il comitato è formato da residenti e domiciliati di Acilia Nord, e l'adesione è aperta a tutti i cittadini del quartiere.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sezione" id="cosa-facciamo">
    <div class="contenitore">
      <h2>Cosa facciamo</h2>
      <ul class="attivita">
        {attivita.map((a) => (
          <li>
            <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
              <circle cx="24" cy="24" r="24" fill={a.colore} />
              <Fragment set:html={a.icona} />
            </svg>
            <div>
              <h3>{a.titolo}</h3>
              <p>{a.testo}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sezione">
    <div class="contenitore">
      <h2>Il direttivo</h2>
      <p class="tenue">Eletto dai cittadini {direttivo.eletto}.</p>
      <ul class="cariche">
        {direttivo.cariche.map((c) => (
          <li>
            <span class="ruolo">{c.ruolo}</span>
            <strong>{c.nome}</strong>
          </li>
        ))}
      </ul>
      <h3>Consiglieri</h3>
      <ul class="elenco-semplice">
        {direttivo.consiglieri.map((nome) => <li>{nome}</li>)}
      </ul>
    </div>
  </section>

  <section class="sezione">
    <div class="contenitore misura">
      <h2>Lo statuto</h2>
      <p>Finalità, regole e organi del comitato, approvati alla sua fondazione.</p>
      <a class="bottone bottone-vuoto" href="/chi-siamo/statuto/">Leggi lo statuto</a>
    </div>
  </section>
</Base>

<style>
  .attivita {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.25rem 2.75rem;
  }

  .attivita li {
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .attivita svg {
    width: 3.6rem;
    height: 3.6rem;
  }

  .attivita h3 {
    margin: 0.3rem 0 0.3rem;
    font-size: 1.15rem;
  }

  .attivita p {
    margin: 0;
  }

  @media (max-width: 64rem) {
    .attivita {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .attivita {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
