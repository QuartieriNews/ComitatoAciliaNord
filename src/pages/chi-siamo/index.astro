---
import Base from '../../layouts/Base.astro';
import Ritratto from '../../components/Ritratto.astro';
import { comitato, direttivo } from '../../data/comitato';

// Colori dei riquadri del direttivo, presi dal cerchio del logo (abbastanza scuri per la figura bianca)
const coloriRitratti = ['#1182ae', '#d60a8b', '#1e8f34', '#6c2e83', '#e84435', '#0f6a8d', '#c75f00', '#9246b9', '#b12152', '#146c44', '#2d6fb7', '#d90a75', '#034c4f'];

// Cosa facciamo: ogni attività ha un'icona bianca in un tondo colorato, come i badge della home.
// I colori vengono dal cerchio di persone del logo.
const persona = (x: number, y: number, s: number) =>
  `<g transform="translate(${x} ${y}) scale(${s})"><circle r="17.2"/><path d="M-33.47 5.86A33.5 33.5 0 1 0 33.47 5.86A36.6 36.6 0 0 1-33.47 5.86Z"/></g>`;

const attivita = [
  {
    titolo: 'Partecipazione',
    testo: 'Favoriamo la partecipazione dei cittadini e la collaborazione con enti pubblici, privati e altre associazioni del territorio.',
    colore: '#d60a8b',
    icona: `<g fill="#fff">${persona(13, 24, 0.2)}${persona(35, 24, 0.2)}${persona(24, 19, 0.25)}</g>`,
  },
  {
    titolo: 'Richieste dei residenti',
    testo: 'Portiamo le richieste dei residenti alla pubblica amministrazione e ai gestori dei servizi, e le seguiamo fino alla risposta.',
    colore: '#e84435',
    icona: `<path fill="#fff" d="M14 12h20a4 4 0 0 1 4 4v13a4 4 0 0 1-4 4H22l-7 6v-6h-1a4 4 0 0 1-4-4V16a4 4 0 0 1 4-4z"/><path d="M17.5 22.5 21.5 26.5 30.5 17.5" fill="none" stroke="#e84435" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    titolo: 'Un quartiere vivibile',
    testo: 'Ci occupiamo di sicurezza, urbanistica, ambiente, decoro urbano e viabilità.',
    colore: '#1e8f34',
    icona: `<g fill="#fff"><path d="M9 25 19.5 15.5 30 25v12H9z"/><circle cx="35" cy="22" r="6"/><rect x="33.8" y="26" width="2.4" height="11" rx="1"/></g><rect x="17" y="29" width="5" height="8" rx="1" fill="#1e8f34"/>`,
  },
  {
    titolo: 'Eccellenze del territorio',
    testo: 'Valorizziamo le eccellenze del territorio: Ficana, la Riserva Statale del Litorale Romano, le Casette Pater.',
    colore: '#6c2e83',
    icona: `<g fill="#fff"><path d="M9 18 24 10l15 8z"/><rect x="10" y="19.5" width="28" height="3" rx="1"/><rect x="12.5" y="24" width="3.4" height="10"/><rect x="19.2" y="24" width="3.4" height="10"/><rect x="25.4" y="24" width="3.4" height="10"/><rect x="32.1" y="24" width="3.4" height="10"/><rect x="9" y="35" width="30" height="3.2" rx="1"/></g>`,
  },
  {
    titolo: 'Piano di Recupero Urbano',
    testo: 'Seguiamo il completamento del Piano di Recupero Urbano Acilia-Dragona.',
    colore: '#1182ae',
    icona: `<g fill="#fff"><rect x="17" y="11" width="4" height="26" rx="1"/><rect x="9" y="13" width="31" height="3.2" rx="1"/><rect x="31.5" y="24" width="5" height="4" rx="1"/><rect x="12" y="36" width="14" height="3" rx="1"/></g><path d="M19 8 10 13M19 8 39 13M34 16v8" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/>`,
  },
  {
    titolo: 'Informazione',
    testo: 'Informiamo i cittadini con volantini, social, il giornalino «La voce di Acilia Nord» e le assemblee pubbliche.',
    colore: '#c75f00',
    icona: `<rect x="11" y="12" width="26" height="25" rx="2.5" fill="#fff"/><g fill="#c75f00"><rect x="14.5" y="16" width="19" height="4" rx="1"/><rect x="14.5" y="23.5" width="8.5" height="2" rx="1"/><rect x="14.5" y="27.5" width="8.5" height="2" rx="1"/><rect x="14.5" y="31.5" width="8.5" height="2" rx="1"/><rect x="25" y="23.5" width="8.5" height="10" rx="1"/></g>`,
  },
];
---

<Base title="Chi siamo" description="Il Comitato di Quartiere Acilia Nord 2018: chi siamo, cosa facciamo e chi fa parte del direttivo.">
  <section class="pagina-testa">
    <div class="contenitore chi-testa">
      <div>
        <h1>Chi siamo</h1>
        <p class="introduzione">
          Il {comitato.nome} è nato il {comitato.fondazione} dall'incontro di volontari nati e cresciuti nel quartiere.
          Ci occupiamo di {comitato.zone}: dei problemi da risolvere, ma anche dei punti di forza e delle eccellenze che ci circondano.
        </p>
      </div>
      <div class="chi-video">
        <!-- Video del comitato: parte da solo una volta, senza audio, e si ferma sull'ultima schermata.
             Orizzontale su computer e tablet, verticale sul telefono. -->
        <video
          id="video-chi-siamo"
          muted
          playsinline
          controls
          preload="metadata"
          poster="/video/chi-siamo-orizzontale.webp"
          width="1280"
          height="720"
          aria-label="Video di presentazione del comitato"
        >
          <source src="/video/chi-siamo-verticale.mp4" type="video/mp4" media="(max-width: 47.99rem)" />
          <source src="/video/chi-siamo-orizzontale.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <script is:inline>
    // Il video parte quando è visibile, una sola volta. Chi ha chiesto di ridurre il movimento
    // vede l'immagine iniziale e può avviarlo con il tasto play.
    (function () {
      var video = document.getElementById('video-chi-siamo');
      if (!video) return;
      if (window.matchMedia('(max-width: 47.99rem)').matches) video.poster = '/video/chi-siamo-verticale.webp';
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var partito = false;
      function parti() {
        if (partito) return;
        partito = true;
        var avvio = video.play();
        if (avvio && avvio.catch) avvio.catch(function () {});
      }
      if (!('IntersectionObserver' in window)) return parti();
      var osservatore = new IntersectionObserver(
        function (voci) {
          if (voci.some(function (v) { return v.isIntersecting; })) {
            osservatore.disconnect();
            parti();
          }
        },
        { threshold: 0.5 },
      );
      osservatore.observe(video);
    })();
  </script>

  <section class="sezione">
    <div class="contenitore">
      <h2>Volontari, apolitici, uno di noi</h2>
      <div class="tre">
        <div class="passo">
          <h3>Volontari</h3>
          <p>Molti interventi a cui ci dedichiamo dovrebbero arrivare dalle amministrazioni. Ma l'esempio può spingerle a intervenire dove serve.</p>
        </div>
        <div class="passo">
          <h3>Apolitici</h3>
          <p>Il comitato è autonomo e apartitico. Chi ricopre cariche politiche o di partito non può far parte del direttivo.</p>
        </div>
        <div class="passo">
          <h3>Uno di noi</h3>
          <p>Il comitato è formato da residenti e domiciliati di Acilia Nord, e l'adesione è aperta a tutti i cittadini del quartiere.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sezione" id="cosa-facciamo">
    <div class="contenitore">
      <h2>Cosa facciamo</h2>
      <ul class="attivita">
        {attivita.map((a) => (
          <li>
            <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
              <circle cx="24" cy="24" r="24" fill={a.colore} />
              <Fragment set:html={a.icona} />
            </svg>
            <div>
              <h3>{a.titolo}</h3>
              <p>{a.testo}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sezione" id="premio">
    <div class="contenitore premio">
      <div class="premio-testo">
        <h2>Premio «Energie per Roma» 2026</h2>
        <p>Il 12 gennaio 2026, nella Sala della Protomoteca in Campidoglio, il {comitato.nome} ha ricevuto il premio «Energie per Roma» del Centro Europeo Studi Culturali. Su 1.200 candidature, la commissione ha scelto 50 realtà di Roma: imprenditori, artisti, professionisti, associazioni e comitati.</p>
        <blockquote>
          <p>«In riconoscimento per lo straordinario contributo profuso nella valorizzazione e nella promozione della Città di Roma.»</p>
          <footer>La motivazione scritta sull'attestato</footer>
        </blockquote>
        <p>È un premio per le volontarie e i volontari che dedicano il loro tempo al quartiere. Se vuoi unirti a loro, <a href="/partecipa/">ecco come partecipare</a>.</p>
      </div>
      <figure class="premio-foto">
        <img src="/premio/energie-per-roma-2026.webp" alt="L'attestato del premio «Energie per Roma» mostrato nella Sala della Protomoteca, in Campidoglio" width="924" height="1155" loading="lazy" />
        <img class="premio-attestato" src="/premio/attestato.webp" alt="L'attestato del premio «Energie per Roma» 2026, conferito al Comitato Acilia Nord 2018" width="480" height="640" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="sezione direttivo" id="direttivo">
    <div class="contenitore">
      <h2>Il direttivo</h2>
      <p class="tenue">Eletto dai cittadini {direttivo.eletto}.</p>
      <ul class="persone persone-cariche">
        {direttivo.cariche.map((p, i) => (
          <li>
            <Ritratto nome={p.nome} foto={p.foto} colore={coloriRitratti[i % coloriRitratti.length]} />
            <strong>{p.nome}</strong>
            <span class="ruolo">{p.ruolo}</span>
          </li>
        ))}
      </ul>
      <h3>Consiglieri</h3>
      <ul class="persone persone-consiglieri">
        {direttivo.consiglieri.map((p, i) => (
          <li>
            <Ritratto nome={p.nome} foto={p.foto} colore={coloriRitratti[(i + 4) % coloriRitratti.length]} />
            <strong>{p.nome}</strong>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sezione">
    <div class="contenitore misura">
      <h2>Lo statuto</h2>
      <p>Finalità, regole e organi del comitato, approvati alla sua fondazione.</p>
      <a class="bottone bottone-vuoto" href="/chi-siamo/statuto/">Leggi lo statuto</a>
    </div>
  </section>
</Base>

<style>
  /* Testata con il video: testo a sinistra e video a destra sul computer, uno sotto l'altro sul telefono */
  .chi-testa {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: 2.5rem;
    align-items: center;
  }

  .chi-video video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    background: #f3ede4;
    box-shadow:
      0 1px 3px rgb(29 37 48 / 0.12),
      0 12px 30px rgb(29 37 48 / 0.14);
  }

  @media (max-width: 64rem) {
    .chi-testa {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  @media (max-width: 47.99rem) {
    .chi-video video {
      aspect-ratio: 9 / 16;
      width: auto;
      max-width: 100%;
      max-height: 80svh;
      margin-inline: auto;
    }
  }

  /* Il premio: testo a sinistra, foto a destra con l'attestato appoggiato sopra.
     Il bronzo richiama i fregi dell'attestato. */
  .premio {
    --bronzo: #a0692c;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 3.5rem;
    align-items: center;
  }

  .premio-testo > * {
    max-width: var(--misura);
  }

  .premio blockquote {
    margin: 1.6rem 0;
    padding: 0.15rem 0 0.15rem 1.2rem;
    border-left: 4px solid var(--bronzo);
  }

  .premio blockquote p {
    margin: 0 0 0.45rem;
    font-size: 1.3rem;
    line-height: 1.42;
    color: var(--inchiostro);
  }

  .premio blockquote footer {
    color: var(--tenue);
    font-size: 0.95rem;
  }

  .premio-foto {
    position: relative;
    width: 100%;
    max-width: 25rem;
    margin: 0 1.25rem 1.75rem auto;
  }

  .premio-foto > img:first-child {
    width: 100%;
    border-radius: 12px;
    box-shadow:
      0 1px 3px rgb(29 37 48 / 0.12),
      0 12px 30px rgb(29 37 48 / 0.14);
  }

  .premio-attestato {
    position: absolute;
    right: -1.25rem;
    bottom: -1.75rem;
    width: 36%;
    border: 6px solid #fff;
    border-radius: 4px;
    box-shadow:
      0 2px 6px rgb(29 37 48 / 0.18),
      0 14px 32px rgb(29 37 48 / 0.22);
    transform: rotate(2.5deg);
  }

  @media (max-width: 52rem) {
    .premio {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .premio-foto {
      margin: 0 auto 2.25rem;
      max-width: 22rem;
    }

    .premio-attestato {
      right: -0.4rem;
      bottom: -2.25rem;
      width: 34%;
    }
  }

  /* Il direttivo: un riquadro per ogni persona, foto o figura del logo, in colonne della stessa larghezza
     allineate a sinistra sotto il titolo */
  .direttivo {
    background: var(--carta-b);
  }

  .persone {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    justify-content: start;
    gap: 2.75rem 2rem;
    text-align: center;
  }

  .persone li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  /* il nome sta ben staccato dal riquadro, oltre la sua cornice colorata
     (:global perché il riquadro è dentro il componente Ritratto) */
  .persone li > :global(.ritratto) {
    margin-bottom: 1.6rem;
  }

  .persone strong {
    font-size: 1.05rem;
    line-height: 1.3;
  }

  /* le quattro cariche: due per riga sui telefoni, tutte in fila dal tablet in su */
  .persone-cariche {
    --misura-ritratto: 8.5rem;
    grid-template-columns: repeat(2, 10.5rem);
    margin: 2.25rem 0 3.75rem;
  }

  @media (min-width: 41rem) {
    .persone-cariche {
      grid-template-columns: repeat(4, minmax(0, 11rem));
      column-gap: 1.5rem;
    }
  }

  @media (min-width: 60rem) {
    .persone-cariche {
      column-gap: 2.25rem;
    }
  }

  .persone-consiglieri {
    --misura-ritratto: 6.5rem;
    grid-template-columns: repeat(auto-fill, 9.5rem);
    margin-top: 1.75rem;
  }

  .direttivo h3 {
    margin-top: 0;
  }

  @media (max-width: 26rem) {
    .persone {
      gap: 2.5rem 1rem;
    }

    .persone-cariche {
      --misura-ritratto: 7rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .persone-consiglieri {
      --misura-ritratto: 5.5rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .attivita {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.25rem 2.75rem;
  }

  .attivita li {
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .attivita svg {
    width: 3.6rem;
    height: 3.6rem;
  }

  .attivita h3 {
    margin: 0.3rem 0 0.3rem;
    font-size: 1.15rem;
  }

  .attivita p {
    margin: 0;
  }

  @media (max-width: 64rem) {
    .attivita {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .attivita {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
