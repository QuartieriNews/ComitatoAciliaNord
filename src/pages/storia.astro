---
// «La nostra storia»: il quartiere in otto capitoli, uno per epoca.
// Sotto il titolo c'è la linea del tempo: sul telefono una striscia che resta in cima allo schermo
// e scorre di lato, sul computer una colonna fissa a sinistra. Si accende sul capitolo che si sta
// leggendo. Ogni capitolo ha un indirizzo suo (/storia/#lido-duranti) da condividere.
// Testi, colori e foto sono in src/data/storia.ts.
import Base from '../layouts/Base.astro';
import { comitato, doveSiamo } from '../data/comitato';
import { apertura, capitoli, dateDaRicordare, libri, inRete, ringraziamenti, type FotoStoria } from '../data/storia';

const colori = (c: { vivo: string; scuro: string; chiaro: string; fondo: string; suFondo: string }) =>
  `--vivo:${c.vivo};--scuro:${c.scuro};--chiaro:${c.chiaro};--fondo:${c.fondo};--su-fondo:${c.suFondo}`;
const perId = new Map(capitoli.map((c) => [c.id, c]));

const src = (f: FotoStoria, larghezza = f.larghezze[0]) => `/storia/${f.nome}-${larghezza}.webp`;
const srcset = (f: FotoStoria) => f.larghezze.map((l) => `${src(f, l)} ${l}w`).join(', ');
const grande = (f: FotoStoria) => src(f, f.larghezze[f.larghezze.length - 1]);

// Larghezza a cui si vedono le foto: la prima del capitolo è larga quanto il testo, le altre in griglia
const misuraApertura = '(min-width: 64rem) 44rem, calc(100vw - 2rem)';
const misuraGriglia = '(min-width: 64rem) 21rem, (min-width: 34rem) 45vw, calc(100vw - 2rem)';

const titoloPagina = 'La nostra storia';
---

<Base
  title={titoloPagina}
  description="La storia di Acilia Nord raccontata dal comitato: da Ficana alle Casette Pater, da Lido Duranti al Sentiero Pasolini, con le foto della mostra."
>
  <section class="pagina-testa">
    <div class="contenitore">
      <h1>{apertura.titolo}</h1>
      <p class="introduzione">{apertura.sottotitolo}</p>
    </div>
  </section>

  <div class="storia">
    <nav class="linea" id="linea-del-tempo" aria-label="Linea del tempo">
      <p class="linea-titolo" aria-hidden="true">Linea del tempo</p>
      <ol>
        {
          capitoli.map((c) => (
            <li style={colori(c)}>
              <a href={`#${c.id}`}>
                <span class="punto" aria-hidden="true" />
                <span class="linea-testo">
                  <span class="linea-anno">{c.anno}</span>
                  <span class="linea-nome">{c.breve}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="corpo">
      <section class="inizio" aria-label="Introduzione">
        {apertura.paragrafi.map((p) => <p>{p}</p>)}

        <section class="date" aria-labelledby="date-titolo">
          <h2 id="date-titolo">Le date da ricordare</h2>
          <ol>
            {
              dateDaRicordare.map((d) => {
                const c = perId.get(d.capitolo)!;
                return (
                  <li style={colori(c)}>
                    <a href={`#${c.id}`}>
                      <span class="date-quando">{d.quando}</span>
                      <span class="date-cosa">{d.cosa}</span>
                    </a>
                  </li>
                );
              })
            }
          </ol>
        </section>
      </section>

      {
        capitoli.map((c, i) => {
          const prima = c.foto[0];
          const altre = c.foto.slice(1);
          const prec = capitoli[i - 1];
          const succ = capitoli[i + 1];
          return (
            <section class="capitolo" id={c.id} style={colori(c)} aria-labelledby={`${c.id}-titolo`}>
              <p class="bollino">
                <span class="bollino-numero" aria-hidden="true">{c.numero}</span>
                <span>
                  Capitolo {c.numero} · {c.periodo}
                </span>
              </p>
              <h2 id={`${c.id}-titolo`}>{c.titolo}</h2>
              <p class="in-breve">
                <strong>In breve.</strong> {c.inBreve}
              </p>

              {prima && (
                <figure class="foto foto-grande">
                  <a class="cornice" href={grande(prima)} data-visore>
                    <img
                      src={src(prima)}
                      srcset={srcset(prima)}
                      sizes={misuraApertura}
                      width={prima.w}
                      height={prima.h}
                      alt={prima.alt}
                      loading={i === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </a>
                  <figcaption>{prima.didascalia}</figcaption>
                </figure>
              )}

              <div class="racconto">
                {c.paragrafi.map((p) => (
                  <p>{p}</p>
                ))}
              </div>

              {altre.length > 0 && (
                <section class="mostra" aria-labelledby={`${c.id}-foto`}>
                  <h3 id={`${c.id}-foto`}>Foto della mostra</h3>
                  <div class="griglia">
                    {altre.map((f) => (
                      <figure class="foto">
                        <a class="cornice" href={grande(f)} data-visore>
                          <img
                            src={src(f)}
                            srcset={srcset(f)}
                            sizes={misuraGriglia}
                            width={f.w}
                            height={f.h}
                            alt={f.alt}
                            loading="lazy"
                            decoding="async"
                          />
                        </a>
                        <figcaption>{f.didascalia}</figcaption>
                      </figure>
                    ))}
                  </div>
                </section>
              )}

              <div class="riquadri">
                <aside class="riquadro" aria-labelledby={`${c.id}-dove`}>
                  <h3 id={`${c.id}-dove`}>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 2.5a7 7 0 0 0-7 7c0 5.1 7 12 7 12s7-6.9 7-12a7 7 0 0 0-7-7zm0 9.6a2.6 2.6 0 1 1 0-5.2 2.6 2.6 0 0 1 0 5.2z" />
                    </svg>
                    Dove si vede ancora oggi
                  </h3>
                  <p>{c.dove}</p>
                </aside>
                <aside class="riquadro" aria-labelledby={`${c.id}-sapevi`}>
                  <h3 id={`${c.id}-sapevi`}>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 2a7 7 0 0 0-4.2 12.6c.7.5 1.2 1.3 1.2 2.2V18h6v-1.2c0-.9.5-1.7 1.2-2.2A7 7 0 0 0 12 2zM9 19.5h6V21a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1z" />
                    </svg>
                    Lo sapevi?
                  </h3>
                  <p>{c.sapevi}</p>
                </aside>
              </div>

              <nav class="passi" aria-label={`Dopo il capitolo ${c.numero}`}>
                {prec ? (
                  <a class="passo-prec" href={`#${prec.id}`} style={colori(prec)}>
                    <span class="passo-etichetta">← Capitolo precedente</span>
                    <span class="passo-titolo">{prec.titolo}</span>
                  </a>
                ) : (
                  <span />
                )}
                {succ ? (
                  <a class="passo-succ" href={`#${succ.id}`} style={colori(succ)}>
                    <span class="passo-etichetta">Capitolo successivo →</span>
                    <span class="passo-titolo">{succ.titolo}</span>
                  </a>
                ) : (
                  <a class="passo-succ passo-fine" href="#raccontacela">
                    <span class="passo-etichetta">E adesso →</span>
                    <span class="passo-titolo">La storia continua: raccontacela tu</span>
                  </a>
                )}
                <div class="passi-riga">
                  <a class="passo-su" href="#linea-del-tempo">↑ Torna alla linea del tempo</a>
                  <button type="button" class="condividi" data-condividi={`/storia/#${c.id}`} data-titolo={`${c.titolo} – ${titoloPagina}`} hidden>
                    Condividi il capitolo
                  </button>
                </div>
              </nav>
            </section>
          );
        })
      }

      <section class="chiusura" id="raccontacela" aria-labelledby="chiusura-titolo">
        <div class="fregio" aria-hidden="true"></div>
        <div class="chiusura-testo">
          <h2 id="chiusura-titolo">La storia continua: raccontacela tu</h2>
          <p>
            Questa storia non è finita, e non l'abbiamo scritta da soli. Tante foto della mostra ce le hanno prestate le
            famiglie del quartiere; ogni ricordo è arrivato da qualcuno che ha avuto voglia di raccontarlo.
          </p>
          <p>
            Se avete in un cassetto una foto delle Casette Pater, di piazza Capelvenere, della stazione o di una festa di
            tanti anni fa, portatela in sede: ne faremo una copia, e l'originale torna a casa con voi. Anche un'immagine
            custodita in un cassetto può aggiungere un tassello importante alla memoria di tutti.
          </p>
          <p>
            Vi aspettiamo nella sede del comitato, in {doveSiamo}, il {comitato.apertura.giorno} {comitato.apertura.orario}.
            Oppure scriveteci a <a href={`mailto:${comitato.email}`}>{comitato.email}</a>.
          </p>
          <p class="passaparola">Passaparola e condividi!</p>
          <div class="azioni">
            <a class="bottone bottone-pieno" href={comitato.sede.mappa}>Come arrivare in sede</a>
            <button type="button" class="bottone bottone-vuoto condividi" data-condividi="/storia/" data-titolo={titoloPagina} hidden>
              Condividi la pagina
            </button>
          </div>
        </div>
      </section>

      <section class="fonti" aria-labelledby="fonti-titolo">
        <h2 id="fonti-titolo">Per saperne di più</h2>
        <p class="tenue">
          Il racconto nasce dalla mostra del comitato e dai ricordi delle famiglie. Date, nomi e numeri li abbiamo
          controllati su questi libri e su altre fonti.
        </p>
        <h3>Libri</h3>
        <ul>
          {libri.map((l) => <li>{l.link ? <a href={l.link}>{l.testo}</a> : l.testo}</li>)}
        </ul>
        <h3>In rete</h3>
        <ul>
          {
            inRete.map((l) => (
              <li>
                <a href={l.link}>{l.testo}</a>
              </li>
            ))
          }
        </ul>
        <p class="grazie">{ringraziamenti}</p>
      </section>
    </div>
  </div>

  <dialog class="visore" aria-label="Foto ingrandita">
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <button type="button" class="visore-chiudi" aria-label="Chiudi">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
  </dialog>
</Base>

<style>
  /* La pagina, sul telefono: una colonna sola, la linea del tempo in cima */
  .storia {
    width: min(100% - 2rem, var(--larghezza));
    margin-inline: auto;
    padding-bottom: 3.5rem;
  }

  .corpo {
    min-width: 0;
  }

  /* ——— Linea del tempo ——— */
  .linea {
    position: sticky;
    top: 0;
    z-index: 6;
    margin: 0 -1rem;
    padding: 0.55rem 0 0.6rem;
    background: rgb(255 255 255 / 0.97);
    border-bottom: 1px solid var(--linea);
    box-shadow: 0 8px 16px -14px rgb(29 37 48 / 0.45);
  }

  @supports (backdrop-filter: blur(6px)) {
    .linea {
      background: rgb(255 255 255 / 0.88);
      backdrop-filter: blur(8px);
    }
  }

  .linea-titolo {
    display: none;
  }

  .linea ol {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 1rem;
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 1rem;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .linea ol::-webkit-scrollbar {
    display: none;
  }

  .linea li {
    flex: none;
    scroll-snap-align: start;
  }

  .linea a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.32rem 0.85rem 0.32rem 0.5rem;
    border: 2px solid var(--vivo);
    border-radius: 999px;
    background: var(--carta);
    color: var(--testo);
    text-decoration: none;
    line-height: 1.12;
  }

  .punto {
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--vivo);
  }

  .linea-testo {
    display: block;
  }

  .linea-anno {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--tenue);
  }

  .linea-nome {
    display: block;
    font-size: 0.86rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .linea a[aria-current] {
    background: var(--fondo);
    border-color: var(--fondo);
    color: var(--su-fondo);
  }

  .linea a[aria-current] .linea-anno {
    color: inherit;
  }

  .linea a[aria-current] .punto {
    background: var(--su-fondo);
  }

  /* ——— Apertura ——— */
  .inizio {
    padding-top: 2.25rem;
  }

  .inizio > p {
    max-width: var(--misura);
    font-size: 1.08rem;
  }

  .date {
    max-width: 44rem;
    margin-top: 2rem;
    padding: 1.25rem 1.3rem 1rem;
    border-radius: 12px;
    background: #f7f3ec;
  }

  .date h2 {
    font-size: 1.3rem;
    margin-bottom: 0.7rem;
  }

  .date ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .date li + li {
    border-top: 1px solid #e6dfd3;
  }

  .date a {
    display: grid;
    grid-template-columns: 0.75rem minmax(0, 1fr);
    column-gap: 0.75rem;
    padding: 0.55rem 0;
    color: var(--testo);
    text-decoration: none;
  }

  .date a::before {
    content: '';
    grid-row: 1 / span 2;
    width: 0.75rem;
    height: 0.75rem;
    margin-top: 0.38rem;
    border-radius: 50%;
    background: var(--vivo);
  }

  .date-quando {
    font-weight: 800;
    color: var(--scuro);
  }

  .date a:hover .date-cosa {
    text-decoration: underline;
  }

  @media (min-width: 40rem) {
    .date a {
      grid-template-columns: 0.75rem 10.5rem minmax(0, 1fr);
    }

    .date a::before {
      grid-row: auto;
    }
  }

  /* ——— Capitoli ——— */
  .capitolo {
    margin-top: 3.25rem;
    padding-top: 2.75rem;
    border-top: 1px solid var(--linea);
    scroll-margin-top: 4.4rem;
  }

  .bollino {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.8rem;
    padding: 0.28rem 0.95rem 0.28rem 0.32rem;
    border-radius: 999px;
    background: var(--fondo);
    color: var(--su-fondo);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .bollino-numero {
    display: grid;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 50%;
    background: var(--su-fondo);
    color: var(--fondo);
    font-weight: 800;
  }

  .capitolo h2 {
    color: var(--scuro);
    font-size: clamp(1.75rem, 1.35rem + 1.6vw, 2.4rem);
    max-width: 22ch;
    margin-bottom: 0.75rem;
  }

  .in-breve {
    max-width: var(--misura);
    margin: 0 0 1.6rem;
    padding: 0.85rem 1.1rem;
    border-left: 5px solid var(--vivo);
    border-radius: 0 10px 10px 0;
    background: var(--chiaro);
    font-size: 1.12rem;
    line-height: 1.5;
  }

  .in-breve strong {
    color: var(--scuro);
  }

  .racconto p {
    max-width: var(--misura);
  }

  /* Foto: la prima grande, le altre in griglia. Un tocco le ingrandisce. */
  .foto {
    margin: 0;
  }

  .foto-grande {
    max-width: 44rem;
    margin: 0 0 1.75rem;
  }

  .cornice {
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 8px;
    background: #efe9df;
    cursor: zoom-in;
  }

  .foto-grande img {
    width: 100%;
    max-height: min(34rem, 75vh);
    object-fit: contain;
  }

  .foto figcaption {
    margin-top: 0.55rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--vivo);
    color: var(--tenue);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .mostra {
    max-width: 44rem;
    margin-top: 2rem;
  }

  .mostra h3,
  .riquadro h3 {
    color: var(--scuro);
    font-size: 1.05rem;
  }

  .griglia {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 1.5rem 1.1rem;
  }

  .griglia .cornice {
    aspect-ratio: 3 / 2;
  }

  .griglia img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Dove si vede ancora oggi · Lo sapevi? */
  .riquadri {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
    margin-top: 2rem;
  }

  @media (min-width: 40rem) {
    .riquadri {
      grid-template-columns: 1fr 1fr;
    }
  }

  .riquadro {
    padding: 1rem 1.15rem 1.1rem;
    border-top: 4px solid var(--vivo);
    border-radius: 4px 4px 10px 10px;
    background: var(--chiaro);
  }

  .riquadro h3 {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.45rem;
  }

  .riquadro svg {
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    fill: var(--scuro);
  }

  .riquadro p {
    margin: 0;
  }

  /* Capitolo precedente / successivo */
  .passi {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    max-width: 44rem;
    margin-top: 2.25rem;
  }

  .passi > a {
    display: block;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--linea);
    border-radius: 10px;
    color: var(--testo);
    text-decoration: none;
  }

  .passi > .passo-prec {
    border-left: 5px solid var(--vivo);
  }

  .passi > .passo-succ {
    text-align: right;
    border-right: 5px solid var(--vivo);
  }

  .passo-fine {
    --vivo: var(--pino);
    --scuro: var(--pino);
  }

  .passi > a:hover {
    background: #f6f8f7;
  }

  .passo-etichetta {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--tenue);
  }

  .passo-titolo {
    display: block;
    font-weight: 800;
    color: var(--scuro);
    line-height: 1.25;
  }

  .passi-riga {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    font-size: 0.95rem;
  }

  .passo-su {
    padding: 0.4rem 0;
  }

  .condividi {
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .passi .condividi {
    padding: 0.4rem 0.9rem;
    border: 2px solid var(--scuro);
    border-radius: 999px;
    background: var(--carta);
    color: var(--scuro);
  }

  .passi .condividi:hover {
    background: var(--chiaro);
  }

  @media (max-width: 30rem) {
    .passi {
      grid-template-columns: 1fr;
    }

    .passi > .passo-succ {
      text-align: left;
      border-right: 1px solid var(--linea);
      border-left: 5px solid var(--vivo);
    }
  }

  /* ——— Chiusura ——— */
  .chiusura {
    max-width: 44rem;
    margin-top: 3.5rem;
    overflow: hidden;
    border-radius: 14px;
    background: var(--carta-b);
    scroll-margin-top: 4.4rem;
  }

  .chiusura-testo {
    padding: 1.6rem 1.5rem 1.7rem;
  }

  .chiusura h2 {
    margin-bottom: 0.7rem;
  }

  .passaparola {
    font-weight: 800;
    color: var(--pino);
    margin-bottom: 0;
  }

  .chiusura .azioni {
    margin-top: 1rem;
  }

  .chiusura .condividi {
    background: var(--carta);
  }

  /* ——— Fonti ——— */
  .fonti {
    max-width: 44rem;
    margin-top: 3rem;
  }

  .fonti h2 {
    font-size: 1.45rem;
  }

  .fonti h3 {
    font-size: 1.05rem;
    margin-top: 1.4rem;
    margin-bottom: 0.4rem;
  }

  .fonti ul {
    padding-left: 1.2rem;
  }

  .fonti li {
    margin-bottom: 0.4em;
  }

  .grazie {
    margin-top: 1.5rem;
    font-style: italic;
  }

  /* ——— Computer: la linea del tempo diventa una colonna fissa a sinistra ——— */
  @media (min-width: 64rem) {
    .storia {
      display: grid;
      grid-template-columns: 13.5rem minmax(0, 1fr);
      column-gap: 3.5rem;
      align-items: start;
    }

    /* Con la linea del tempo sempre accanto, i passi fra i capitoli confondono e basta;
       e il bottone per condividere serve sul telefono (richiesta di Riccardo, 5 novembre 2026) */
    .passi,
    .chiusura .condividi {
      display: none;
    }

    .linea {
      top: 1.25rem;
      margin: 2.25rem 0 0;
      padding: 0;
      max-height: calc(100vh - 2.5rem);
      overflow-y: auto;
      background: none;
      border: 0;
      box-shadow: none;
      backdrop-filter: none;
    }

    .linea-titolo {
      display: block;
      margin: 0 0 0.7rem;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--tenue);
    }

    .linea ol {
      flex-direction: column;
      gap: 0.1rem;
      padding: 0;
      overflow: visible;
    }

    /* il filo arcobaleno che unisce i capitoli */
    .linea ol::before {
      content: '';
      position: absolute;
      left: 0.77rem;
      top: 1.1rem;
      bottom: 1.1rem;
      width: 3px;
      border-radius: 2px;
      background: linear-gradient(#ef1828, #ff8e18, #f5d90a, #26aa3c, #27afed, #2d6fb7, #9246b9, #f0008e);
    }

    .linea a {
      position: relative;
      gap: 0.7rem;
      padding: 0.42rem 0.6rem 0.42rem 0.32rem;
      border: 0;
      border-radius: 10px;
      background: transparent;
    }

    .linea a:hover {
      background: #f3f5f4;
    }

    .punto {
      width: 1.1rem;
      height: 1.1rem;
      background: var(--carta);
      border: 3px solid var(--vivo);
    }

    .linea-nome {
      white-space: normal;
      font-size: 0.95rem;
    }

    .linea-anno {
      font-size: 0.78rem;
    }

    .linea a[aria-current] {
      background: var(--chiaro);
      color: var(--testo);
    }

    .linea a[aria-current] .linea-anno {
      color: var(--tenue);
    }

    .linea a[aria-current] .linea-nome {
      color: var(--scuro);
    }

    .linea a[aria-current] .punto {
      background: var(--vivo);
      box-shadow: 0 0 0 3px var(--carta), 0 0 0 5px var(--vivo);
    }

    .capitolo,
    .chiusura {
      scroll-margin-top: 1.25rem;
    }

    .inizio {
      padding-top: 2.5rem;
    }
  }

  /* ——— Visore delle foto ——— */
  .visore {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
  }

  .visore::backdrop {
    background: rgb(14 20 17 / 0.93);
  }

  .visore figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    height: 100%;
    margin: 0;
    padding: 3.75rem 1rem 1.25rem;
  }

  .visore img {
    max-width: 100%;
    max-height: calc(100% - 5rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
  }

  .visore figcaption {
    max-width: 44rem;
    text-align: center;
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .visore-chiudi {
    position: fixed;
    top: 0.8rem;
    right: 0.8rem;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.16);
    color: #fff;
    cursor: pointer;
  }

  .visore-chiudi:hover {
    background: rgb(255 255 255 / 0.28);
  }

  .visore-chiudi svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
  }
</style>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    html:has(.linea) {
      scroll-behavior: smooth;
    }
  }
</style>

<script>
  // La linea del tempo si accende sul capitolo che si sta leggendo;
  // sul telefono la striscia scorre per tenerlo in vista.
  const capitoli = [...document.querySelectorAll<HTMLElement>('.capitolo')];
  const voci = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.linea a')].map((a) => [a.hash.slice(1), a] as const),
  );
  const striscia = document.querySelector<HTMLElement>('.linea ol');
  const chiusura = document.getElementById('raccontacela');
  const riduci = window.matchMedia('(prefers-reduced-motion: reduce)');
  let attivo: string | null = null;
  let inAttesa = false;

  function aggiorna() {
    inAttesa = false;
    const soglia = window.innerHeight * 0.3;
    let corrente: string | null = null;
    for (const c of capitoli) {
      if (c.getBoundingClientRect().top <= soglia) corrente = c.id;
      else break;
    }
    if (chiusura && chiusura.getBoundingClientRect().top <= soglia) corrente = null;
    if (corrente === attivo) return;
    if (attivo) voci.get(attivo)?.removeAttribute('aria-current');
    attivo = corrente;
    const voce = corrente ? voci.get(corrente) : undefined;
    if (!voce) return;
    voce.setAttribute('aria-current', 'location');
    if (striscia && striscia.scrollWidth > striscia.clientWidth + 2) {
      const li = voce.parentElement as HTMLElement;
      const x = li.offsetLeft - (striscia.clientWidth - li.offsetWidth) / 2;
      striscia.scrollTo({ left: Math.max(0, x), behavior: riduci.matches ? 'auto' : 'smooth' });
    }
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!inAttesa) {
        inAttesa = true;
        requestAnimationFrame(aggiorna);
      }
    },
    { passive: true },
  );
  window.addEventListener('resize', aggiorna);
  aggiorna();

  // Il visore: un tocco su una foto la apre grande, con la sua didascalia.
  const visore = document.querySelector<HTMLDialogElement>('.visore');
  if (visore && typeof visore.showModal === 'function') {
    const img = visore.querySelector('img')!;
    const didascalia = visore.querySelector('figcaption')!;
    document.querySelectorAll<HTMLAnchorElement>('a[data-visore]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const piccola = a.querySelector('img');
        img.src = a.href;
        img.alt = piccola?.alt ?? '';
        didascalia.textContent = a.closest('figure')?.querySelector('figcaption')?.textContent ?? '';
        visore.showModal();
      });
    });
    visore.querySelector('.visore-chiudi')?.addEventListener('click', () => visore.close());
    visore.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === visore || t.tagName === 'FIGURE') visore.close();
    });
    visore.addEventListener('close', () => img.removeAttribute('src'));
  }

  // Condividi: sul telefono apre il menu di condivisione (WhatsApp, Facebook…);
  // dove non c'è, copia il link.
  document.querySelectorAll<HTMLButtonElement>('button[data-condividi]').forEach((b) => {
    const testo = b.textContent?.trim() ?? '';
    b.hidden = false;
    b.addEventListener('click', async () => {
      const url = new URL(b.dataset.condividi ?? '/storia/', window.location.href).href;
      if (navigator.share) {
        try {
          await navigator.share({ title: b.dataset.titolo, url });
        } catch {
          // condivisione annullata: niente da fare
        }
        return;
      }
      try {
        await navigator.clipboard.writeText(url);
        b.textContent = 'Link copiato!';
        setTimeout(() => (b.textContent = testo), 2500);
      } catch {
        window.location.href = url;
      }
    });
  });
</script>
