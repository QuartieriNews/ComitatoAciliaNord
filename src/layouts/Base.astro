---
import '@fontsource-variable/atkinson-hyperlegible-next';
import '../styles/global.css';
import { ANTEPRIMA } from '../config';
import { comitato } from '../data/comitato';
import { nomeGiornalino } from '../data/giornalino';

interface Props {
  title?: string;
  description?: string;
  // true solo nella home: lì l'intestazione animata prende il posto del fregio
  home?: boolean;
}

const {
  title,
  description = 'Il Comitato di Quartiere Acilia Nord 2018, a Roma: Monti di San Paolo e Poggio di Acilia. Segnalazioni, decoro, eventi e storia del quartiere.',
  home = false,
} = Astro.props;
const titoloCompleto = title ? `${title} – ${comitato.nome}` : comitato.nome;

const voci = [
  { href: '/chi-siamo/', nome: 'Chi siamo' },
  { href: '/il-quartiere/', nome: 'Il quartiere' },
  { href: '/storia/', nome: 'La nostra storia' },
  { href: '/news/', nome: 'Le notizie' },
  { href: '/giornalino/', nome: nomeGiornalino },
  { href: '/partecipa/', nome: 'Partecipa' },
  { href: '/contatti/', nome: 'Contattaci' },
];

const percorso = Astro.url.pathname;
const attiva = (href: string) => percorso.startsWith(href);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={description} />
    {ANTEPRIMA && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={titoloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/logo-comitato.jpg', Astro.site)} />
    <meta name="theme-color" content="#f3ede4" />
  </head>
  <body>
    <a class="salta" href="#contenuto">Vai al contenuto</a>

    <header class="testata">
      <div class="testata-riga">
        <a class="marchio" href="/">
          <img src="/logo-comitato.webp" alt="" width="54" height="57" />
          <span class="marchio-nome"><span>Comitato di Quartiere</span>{' '}<span>Acilia Nord 2018</span></span>
        </a>

        <nav class="nav-ampia" aria-label="Menu principale">
          <ul>
            {voci.map((v) => (
              <li>
                <a href={v.href} aria-current={attiva(v.href) ? 'page' : undefined}>{v.nome}</a>
              </li>
            ))}
          </ul>
        </nav>

        <details class="nav-stretta">
          <summary>
            <svg class="hamburger" viewBox="0 0 20 14" width="20" height="14" aria-hidden="true">
              <path d="M1 1h18M1 7h18M1 13h18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
            </svg>
            <span class="menu-testo">Menu</span>
          </summary>
          <nav aria-label="Menu principale">
            <ul>
              <li><a href="/" aria-current={percorso === '/' ? 'page' : undefined}>Home</a></li>
              {voci.map((v) => (
                <li>
                  <a href={v.href} aria-current={attiva(v.href) ? 'page' : undefined}>{v.nome}</a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      </div>
      {!home && <div class="fregio" aria-hidden="true"></div>}
    </header>

    <main id="contenuto">
      <slot />
    </main>

    <footer class="piede">
      <div class="fregio" aria-hidden="true"></div>
      <div class="contenitore">
        <div class="piede-griglia">
          <div>
            <h2>{comitato.sede.nome}</h2>
            <p>{comitato.sede.indirizzo}, {comitato.sede.citta}</p>
            <p>Aperta il {comitato.apertura.giorno} {comitato.apertura.orario}</p>
            <p><a href={comitato.sede.mappa}>Apri la mappa</a></p>
          </div>
          <div>
            <h2>Contatti</h2>
            <p><a href={`mailto:${comitato.email}`}>{comitato.email}</a></p>
            <p><a href={`tel:${comitato.telefonoLink}`}>{comitato.telefono}</a></p>
          </div>
          <div>
            <h2>Seguici</h2>
            <p><a href={comitato.facebook}>Pagina Facebook</a></p>
            <p><a href={comitato.whatsapp.link}>{comitato.whatsapp.nome} su WhatsApp</a></p>
          </div>
        </div>
        <div class="piede-fondo">
          <span>{comitato.nome}</span>
          <span>Codice fiscale {comitato.codiceFiscale}</span>
          <a href="/privacy/">Privacy</a>
        </div>
      </div>
    </footer>
  </body>
</html>
